@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 10
skinparam classFontSize 10
skinparam ranksep 18
skinparam nodesep 16
skinparam linetype polyline
skinparam ClassBackgroundColor White
skinparam ClassBorderColor #444444
skinparam ArrowColor #444444
skinparam class<<library>> {
  BackgroundColor #DDEBF7
  BorderColor #444444
}
skinparam package {
  BackgroundColor #F4F4F4
  BorderColor #444444
}
left to right direction
hide empty members

class SceneLifetimeScope {
  # Configure(IContainerBuilder) : void
}
class IContainerBuilder <<library>>
class Bootstrap

package "Сервіси, зареєстровані як singleton" as Services {
  class EnemySpawner
  class EnemyRegistry
  class PauseManager
  class ShopService
  class StateMachine
}
package "Стани ігрового потоку" as FlowStates {
  class StartingState
  class WaveState
  class WaveEndState
  class LevelUpState
  class ShopState
  class GameOverState
  class VictoryState
}

SceneLifetimeScope ..> IContainerBuilder : <<налаштовує контейнер>>
SceneLifetimeScope ..> Services : <<реєструє сервіси>>
SceneLifetimeScope ..> FlowStates : <<реєструє стани>>
SceneLifetimeScope ..> Bootstrap : <<реєструє точку входу>>
note bottom of Services
  Залежність від пакета стосується
  кожного типу, наведеного в ньому.
end note
@enduml
