abstract class Weapon {
  # _nextFireTime : float = 0f
  # _targetSwitchDelay : float = 0.15
  # HasTarget : bool <<get>>
  + OriginalLocalPosition : Vector3
  + Construct(SoundManager) : void
  + Initialize(Player, WeaponSO) : void
  # UpdateTarget() : void
  # GetAimDirection(Vector3) : Vector2
  # FindNearestEnemy() : Transform
  # LookAtTargetOrInput() : void
  # CanShoot(float) : bool
  # ApplyCooldown(float) : void
  + HandleOnHit(Enemy) : void
  + <<virtual>> UpdateStartPosition(Vector3) : void
  + <<virtual>> SetStats(WeaponSO) : void
  + ResetState() : void
}
class MeeleWeapon {
  +  <<event>> OnHit : Action
}
enum MeeleWeaponState <<enumeration>> {
  Idle
  Attacking
  Returning
}
class MeeleWeaponVisual
class RangeWeapon {
  +  <<event>> OnShoot : Action
  + <<override>> UpdateStartPosition(Vector3) : void
}
class RangeWeaponAnimation {
  + InitializePosition(Vector3) : void
}
class WeaponsHolder {
  + Construct(IObjectResolver) : void
  + Initialize(EquipmentManager, Player, WavesManager) : void
  + Dispose() : void
}
class WeaponVisual {
  + Apply(WeaponSO) : void
}
interface "projectiles::IWeaponBehavior" as IWeaponBehavior <<interface>> #EEEEEE
class "player::PlayerMovement" as PlayerMovement #EEEEEE
class "player::Player" as Player #EEEEEE
class "stats::PlayerStats" as PlayerStats #EEEEEE
class "core_services::SoundManager" as SoundManager #EEEEEE
class "enemies::Enemy" as Enemy #EEEEEE
class "waves::EnemyRegistry" as EnemyRegistry #EEEEEE
class "waves::WavesManager" as WavesManager #EEEEEE
class "items_rarity::EquipmentManager" as EquipmentManager #EEEEEE
class "items_rarity::RarityConfigSO" as RarityConfigSO #EEEEEE
class MonoBehaviour <<library>> #DDEBF7
package "weapons_data" as OUT_weapons_data #EEEEEE {
  class "MeeleWeaponSO\nRangeWeaponSO\nWeaponSO" as OUT_weapons_data_n <<names>>
}
package "інші пакети" as IN_all #EEEEEE {
  class "projectiles::PlayerBullet\ncore_boot::Bootstrap\ncore_boot::SceneLifetimeScope\nprojectiles::IWeaponBehavior\nprojectiles::BurstShotBehavior\nprojectiles::ShotgunBehavior\nprojectiles::SingleShotBehavior" as IN_all_n <<names>>
}
