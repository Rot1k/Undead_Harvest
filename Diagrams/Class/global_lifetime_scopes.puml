@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 10
skinparam classFontSize 10
skinparam ranksep 18
skinparam nodesep 12
skinparam linetype polyline
skinparam ClassBackgroundColor White
skinparam ClassBorderColor #444444
skinparam ArrowColor #444444
skinparam class<<library>> {
  BackgroundColor #DDEBF7
  BorderColor #444444
}
skinparam package {
  BackgroundColor #F4F4F4
  BorderColor #444444
}
top to bottom direction
hide empty members

class MonoBehaviour <<library>>
class LifetimeScope <<library>>
class GlobalLifetimeScope {
  # Configure(IContainerBuilder) : void
}
class IContainerBuilder <<library>>
package "Компоненти, задані в Inspector" as GlobalComponents {
  class GameInput
  class MasterVolumeManager
  class BackgroundMusicManager
  class SoundManager
}

MonoBehaviour <|-- LifetimeScope
LifetimeScope <|-- GlobalLifetimeScope
GlobalLifetimeScope ..> IContainerBuilder : <<налаштовує контейнер>>
GlobalLifetimeScope ..> GlobalComponents : <<реєструє компоненти>>
note bottom of GlobalComponents
  Кожен тип у пакеті має
  серіалізоване посилання в scope.
end note
@enduml
