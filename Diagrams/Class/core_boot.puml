@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 10
skinparam classFontSize 10
skinparam classAttributeFontSize 9
skinparam stereotypeFontSize 8
skinparam ranksep 18
skinparam nodesep 12
skinparam linetype polyline
skinparam ClassBackgroundColor White
skinparam ClassBorderColor #444444
skinparam ArrowColor #444444
skinparam class<<library>> {
  BackgroundColor #DDEBF7
  BorderColor #444444
}
skinparam package {
  BackgroundColor #F4F4F4
  BorderColor #444444
}
hide circle
top to bottom direction
hide empty members

class Bootstrap {
  + Bootstrap(15 DI dependencies)
  + Start() : void
  + Dispose() : void
}
class "player::Player" as Player #EEEEEE
class "waves::WavesManager" as WavesManager #EEEEEE
class "items_rarity::EquipmentManager" as EquipmentManager #EEEEEE
class "weapons::WeaponsHolder" as WeaponsHolder #EEEEEE
class "player::PlayerDamageReceiver" as PlayerDamageReceiver #EEEEEE
class "player::PlayerAnimation" as PlayerAnimation #EEEEEE
class "ui_hud::UIBootstrap" as UIBootstrap #EEEEEE
class "flow::StateMachine" as StateMachine #EEEEEE
class "flow::StartingState" as StartingState #EEEEEE
class "flow::WaveState" as WaveState #EEEEEE
class "flow::WaveEndState" as WaveEndState #EEEEEE
class "flow::LevelUpState" as LevelUpState #EEEEEE
class "flow::ShopState" as ShopState #EEEEEE
class "flow::GameOverState" as GameOverState #EEEEEE
class "flow::VictoryState" as VictoryState #EEEEEE
interface IStartable <<interface>> <<library>>
interface IDisposable <<interface>> <<library>>
class LifetimeScope <<library>>
class GlobalLifetimeScope {
  - _gameInput : GameInput
  - _masterVolumeManager : MasterVolumeManager
  - _backgroundMusicManager : BackgroundMusicManager
  - _soundManager : SoundManager
  # Configure(IContainerBuilder) : void {override}
}
class MainMenuLifetimeScope {
  # Configure(IContainerBuilder) : void {override}
}
class SceneLifetimeScope {
  - _wavesManager : WavesManager
  - _waveEndWindow : WaveEndWindow
  - _equipmentManager : EquipmentManager
  - _weaponHolder : WeaponsHolder
  - _walletManager : WalletManager
  - _player : Player
  - _playerDamageReceiver : PlayerDamageReceiver
  - _playerAnimation : PlayerAnimation
  - _UIBootstrap : UIBootstrap
  # Configure(IContainerBuilder) : void {override}
}
class IContainerBuilder <<library>>
class IObjectResolver <<library>>
class Loader <<static>> {
  + {static} <<event>> OnAfterSceneLoad : Action
  + {static} Load(Scene) : void
  + {static} LoaderCallback() : void
}
class LoaderCallback
class PauseManager <<sealed>> {
  - _pauseCount : int
  + PauseCount : int {get;}
  + IsPaused : bool {get;}
  + Pause() : void
  + Unpause() : void
}
enum Scene <<enumeration>> {
  MainMenuScene
  GameScene
  LoadingScene
}
class MonoBehaviour <<library>>

MonoBehaviour <|-- LifetimeScope
IStartable <|.. Bootstrap
IDisposable <|.. Bootstrap
LifetimeScope <|-- GlobalLifetimeScope
LifetimeScope <|-- MainMenuLifetimeScope
LifetimeScope <|-- SceneLifetimeScope
MonoBehaviour <|-- LoaderCallback
Bootstrap --> Player
Bootstrap --> WavesManager
Bootstrap --> EquipmentManager
Bootstrap --> WeaponsHolder
Bootstrap --> PlayerDamageReceiver
Bootstrap --> PlayerAnimation
Bootstrap --> UIBootstrap
Bootstrap --> StateMachine
Bootstrap --> StartingState
Bootstrap --> WaveState
Bootstrap --> WaveEndState
Bootstrap --> LevelUpState
Bootstrap --> ShopState
Bootstrap --> GameOverState
Bootstrap --> VictoryState
Player -[hidden]down-> WavesManager
WavesManager -[hidden]down-> EquipmentManager
EquipmentManager -[hidden]down-> WeaponsHolder
WeaponsHolder -[hidden]down-> PlayerDamageReceiver
PlayerDamageReceiver -[hidden]down-> PlayerAnimation
PlayerAnimation -[hidden]down-> UIBootstrap
UIBootstrap -[hidden]down-> StateMachine
StateMachine -[hidden]down-> StartingState
StartingState -[hidden]down-> WaveState
WaveState -[hidden]down-> WaveEndState
WaveEndState -[hidden]down-> LevelUpState
LevelUpState -[hidden]down-> ShopState
ShopState -[hidden]down-> GameOverState
GameOverState -[hidden]down-> VictoryState
SceneLifetimeScope ..> Bootstrap : <<реєструє точку входу>>
SceneLifetimeScope ..> IContainerBuilder : <<налаштовує контейнер>>
GlobalLifetimeScope ..> IContainerBuilder : <<налаштовує контейнер>>
MainMenuLifetimeScope ..> IContainerBuilder : <<налаштовує контейнер>>
SceneLifetimeScope ..> IObjectResolver : <<ін’єктує GameObject-и сцени>>
MainMenuLifetimeScope ..> IObjectResolver : <<ін’єктує кореневі GameObject-и сцени>>
@enduml
