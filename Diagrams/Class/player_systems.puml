  + Die() : void
  + Heal(int) : void
  + Reset(int) : void
}
class LevelSystem {
  +  <<event>> OnLevelChanged : EventHandler
  +  <<event>> OnExpChanged : EventHandler
  +  <<event>> OnSkillPointUsed : EventHandler
  + SkillPoints : int <<get>>
  + Level : ReadOnlyReactiveProperty<int>
  + CurrentExp : ReadOnlyReactiveProperty<float>
  + ExpToNextLevel : ReadOnlyReactiveProperty<float>
  + LevelSystem()
  + AddExp(float) : void
  + UseSkillPoint(int) : void
}
class ItemCollector {
  + Construct(Player) : void
  + AddExp(float) : void
}
class ItemMagnet {
  + Construct(Player) : void
}
class ExpCoin {
  + Construct(WalletManager) : void
  + StartAttraction(Transform, float) : void
  + Collect(ItemCollector) : void
  + OnSpawn() : void
}
interface IDamageable <<interface>>
interface ICollectible <<interface>> {
  Collect(ItemCollector) : void
  StartAttraction(Transform, float) : void
}
class CombatSystem <<static>> {
  + {static} CalculateDamage(PlayerStats, WeaponSO) : float
}
