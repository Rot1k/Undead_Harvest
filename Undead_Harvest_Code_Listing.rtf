public class StatusEffectInstance\par
\{\par
    public StatusEffectSO EffectData \{ get; \}\par
    public Enemy Target \{ get; \}\par
    public bool IsFinished => _stacks.Count == 0;\par
\par
    private readonly List<EffectStack> _stacks = new();\par
    private float _tickTimer;\par
\par
    public StatusEffectInstance(StatusEffectSO effectData, Enemy target)\par
    \{\par
        EffectData = effectData;\par
        Target = target;\par
\par
        foreach (var modifier in EffectData.Modifiers)\par
        \{\par
            modifier.OnApply(this, Target);\par
            Debug.Log(modifier);\par
        \}\par
    \}\par
\par
    public void AddStack(float duration)\par
    \{\par
        _stacks.Add(new EffectStack(duration));\par
    \}\par
\par
    public void Update(float deltaTime)\par
    \{\par
        UpdateStacks(deltaTime);\par
        HandleTick(deltaTime);\par
    \}\par
\par
    private void UpdateStacks(float deltaTime)\par
    \{\par
        for (int i = _stacks.Count - 1; i >= 0; i--)\par
        \{\par
            var stack = _stacks[i];\par
            stack.RemainingDuration -= deltaTime;\par
            _stacks[i] = stack;\par
\par
            if (stack.RemainingDuration <= 0)\par
                _stacks.RemoveAt(i);\par
        \}\par
\par
        if (_stacks.Count == 0)\par
        \{\par
            foreach (var modifier in EffectData.Modifiers)\par
            \{\par
                modifier.OnExpire(this, Target);\par
            \}\par
        \}\par
    \}\par
\par
    private void HandleTick(float deltaTime)\par
    \{\par
        if (EffectData.TickInterval <= 0)\par
            return;\par
\par
        _tickTimer += deltaTime;\par
\par
        if (_tickTimer >= EffectData.TickInterval)\par
        \{\par
            _tickTimer = 0f;\par
\par
            int stackCount = _stacks.Count;\par
\par
            if (stackCount > 0)\par
            \{\par
                foreach (var modifier in EffectData.Modifiers)\par
                    modifier.OnTick(this, Target, stackCount);\par
            \}\par
        \}\par
    \}\par
    public void ForceExpire()\par
    \{\par
        foreach (var modifier in EffectData.Modifiers)\par
        \{\par
            modifier.OnExpire(this, Target);\par
        \}\par
\par
        _stacks.Clear();\par
    \}\par
\par
    public void Refresh(float duration)\par
    \{\par
        if (_stacks.Count > 0)\par
        \{\par
            var stack = _stacks[0];\par
            stack.RemainingDuration = duration;\par
            _stacks[0] = stack;\par
        \}\par
        else\par
        \{\par
            _stacks.Add(new EffectStack(duration));\par
        \}\par
    \}\par
\par
    public int GetStackCount() => _stacks.Count;\par
\par
\}\par
