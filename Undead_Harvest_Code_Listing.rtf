    private void BuildDictionary()\par
    \{\par
        _rarityDict = new Dictionary<Rarity, RarityEntry>();\par
        if (Rarities == null) return;\par
\par
        foreach (var entry in Rarities)\par
        \{\par
            if (entry != null)\par
                _rarityDict[entry.Rarity] = entry;\par
        \}\par
    \}\par
    private void EnsureDictionary()\par
    \{\par
        if (_rarityDict != null) return;\par
\par
        BuildDictionary();\par
    \}\par
\par
    public float GetMultiplier(Rarity rarity)\par
    \{\par
        EnsureDictionary();\par
        return _rarityDict.TryGetValue(rarity, out var entry) ? entry.StatMultiplier : 1f;\par
    \}\par
        \par
\par
    public Color GetColor(Rarity rarity)\par
    \{\par
        EnsureDictionary();\par
        return _rarityDict.TryGetValue(rarity, out var entry) ? entry.Color : Color.white;\par
    \}\par
\par
\par
    public float GetDropChance(Rarity rarity)\par
    \{\par
        EnsureDictionary();\par
        return _rarityDict.TryGetValue(rarity, out var entry) ? entry.DropChance : 0f;\par
    \}\par
    \par
    public RarityEntry GetRandomEntry()\par
    \{\par
        EnsureDictionary();\par
\par
        if (Rarities == null || Rarities.Count == 0)\par
            return new RarityEntry \{ Rarity = Rarity.Common, StatMultiplier = 1f, DropChance = 1f \};\par
\par
        float total = 0f;\par
        foreach (var r in Rarities)\par
            total += r.DropChance;\par
\par
        if (total <= 0f)\par
            return new RarityEntry \{ Rarity = Rarity.Common, StatMultiplier = 1f, DropChance = 1f \};\par
\par
        float roll = Random.Range(0f, total);\par
        float cumulative = 0f;\par
\par
        foreach (var entry in Rarities)\par
        \{\par
            cumulative += entry.DropChance;\par
            if (roll <= cumulative)\par
                return entry;\par
        \}\par
\par
        return Rarities[0];\par
    \}\par
\}\par
