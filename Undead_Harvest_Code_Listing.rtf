    public void Initialize()\par
    \{\par
        Dispose();\par
\par
        if (_baseStats == null)\par
        \{\par
            Debug.LogWarning("Player base stats are not configured.");\par
            return;\par
        \}\par
\par
        if (_baseStats.Stats == null)\par
        \{\par
            Debug.LogWarning("Player base stats list is not configured.");\par
            return;\par
        \}\par
\par
        foreach (var entry in _baseStats.Stats)\par
        \{\par
            if (entry == null)\par
                continue;\par
\par
            var stat = new Stat(entry.Type, entry.BaseValue); // Stat now knows its own type\par
            Action<float> handler = (newValue) => OnStatChanged?.Invoke(entry.Type, newValue);\par
            stat.OnValueChanged += handler;\par
\par
            _stats[entry.Type] = stat;\par
            _statHandlers[entry.Type] = handler;\par
        \}\par
    \}\par
\par
    public void Dispose()\par
    \{\par
        foreach (var kv in _statHandlers)\par
        \{\par
            if (_stats.TryGetValue(kv.Key, out var stat))\par
            \{\par
                stat.OnValueChanged -= kv.Value;\par
            \}\par
        \}\par
        _statHandlers.Clear();\par
        _stats.Clear();\par
    \}\par
