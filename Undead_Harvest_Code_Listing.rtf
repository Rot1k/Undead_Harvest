using System;\par
using System.Collections.Generic;\par
\par
public abstract class State\par
\{\par
    private StateMachine _stateMachine;\par
\par
    internal void Bind(StateMachine stateMachine)\par
    \{\par
        _stateMachine = stateMachine;\par
    \}\par
\par
    protected void ChangeState<TState>()\par
        where TState : State\par
    \{\par
        _stateMachine.ChangeState<TState>();\par
    \}\par
\par
    public virtual void Enter() \{ \}\par
    public virtual void Update() \{ \}\par
    public virtual void Exit() \{ \}\par
\}\par
\par
public class StateMachine\par
\{\par
    private readonly Dictionary<Type, State> _states = new();\par
    private State _currentState;\par
\par
    public State CurrentState => _currentState;\par
\par
    public void Register<TState>(TState state)\par
        where TState : State\par
    \{\par
        if (state == null)\par
            throw new ArgumentNullException(nameof(state));\par
\par
        _states.Add(typeof(TState), state);\par
        state.Bind(this);\par
    \}\par
\par
    public void ChangeState<TState>()\par
        where TState : State\par
    \{\par
        TState nextState = GetState<TState>();\par
\par
        if (ReferenceEquals(_currentState, nextState))\par
            return;\par
\par
        _currentState?.Exit();\par
        _currentState = nextState;\par
        _currentState.Enter();\par
    \}\par
    // public void Update()\par
    // \{\par
    //     _currentState?.Update();\par
    // \}\par
    public void Dispose()\par
    \{\par
        _currentState?.Exit();\par
        _currentState = null;\par
    \}\par
\par
    private TState GetState<TState>()\par
        where TState : State\par
    \{\par
        if (_states.TryGetValue(typeof(TState), out State state))\par
            return (TState)state;\par
\par
        throw new InvalidOperationException(\par
            $"State \{typeof(TState).Name\} is not registered.");\par
    \}\par
\}\par
