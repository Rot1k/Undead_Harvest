public class StatusEffectsManager : MonoBehaviour\par
\{\par
    private Enemy _enemy;\par
\par
    public int ActiveEffectCount => _activeEffects.Count;\par
\par
    private Dictionary<StatusEffectSO, StatusEffectInstance> _activeEffects = new();\par
    private List<StatusEffectSO> _effectsToRemove = new();\par
    private List<StatusEffectSO> _effectsToUpdate = new();\par
\par
    private void Awake()\par
    \{\par
        _enemy = GetComponent<Enemy>();\par
    \}\par
\par
    private void Update()\par
    \{\par
        float dt = Time.deltaTime;\par
\par
        _effectsToUpdate.Clear();\par
        _effectsToUpdate.AddRange(_activeEffects.Keys);\par
\par
        foreach (var effect in _effectsToUpdate)\par
        \{\par
            if (!_activeEffects.TryGetValue(effect, out var instance))\par
                continue;\par
\par
            instance.Update(dt);\par
\par
            if (instance.IsFinished)\par
                _effectsToRemove.Add(effect);\par
        \}\par
\par
        if (_effectsToRemove.Count > 0)\par
        \{\par
            foreach (var key in _effectsToRemove)\par
            \{\par
                _activeEffects.Remove(key);\par
            \}\par
            _effectsToRemove.Clear();\par
        \}\par
    \}\par
\par
    public void ApplyEffect(StatusEffectSO effectSO)\par
    \{\par
        if (_activeEffects.TryGetValue(effectSO, out var instance))\par
        \{\par
            if (!effectSO.IsStackable)\par
            \{\par
                instance.Refresh(effectSO.Duration);\par
                return;\par
            \}\par
\par
            if (instance.GetStackCount() >= effectSO.MaxStacks)\par
                return;\par
\par
            instance.AddStack(effectSO.Duration);\par
        \}\par
        else\par
        \{\par
            var newInstance = new StatusEffectInstance(effectSO, _enemy);\par
            newInstance.AddStack(effectSO.Duration);\par
            _activeEffects.Add(effectSO, newInstance);\par
        \}\par
\par
        OnApplyEffectColorSetter(effectSO.Color);\par
    \}\par
    public void ClearAllEffects()\par
    \{\par
        foreach (var instance in _activeEffects.Values)\par
        \{\par
            instance.ForceExpire();\par
        \}\par
\par
        _activeEffects.Clear();\par
    \}\par
    private void OnApplyEffectColorSetter(Color color)\par
    \{\par
        if (TryGetComponent<EnemyVisual>(out var visual))\par
        \{\par
            StartCoroutine(visual.SetTempColor(color, 0.2f));\par
        \}\par
    \}\par
\}\par
