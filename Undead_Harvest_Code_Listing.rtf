using UnityEngine;\par
using VContainer;\par
using VContainer.Unity;\par
using static WaveConfigSO;\par
\par
public sealed class EnemySpawner\par
\{\par
    private readonly IObjectResolver _objectResolver;\par
\par
    public EnemySpawner(IObjectResolver objectResolver)\par
    \{\par
        _objectResolver = objectResolver;\par
    \}\par
\par
    public IEnumerator SpawnRoutine(\par
        WaveEntry entry,\par
        float waveDuration,\par
        Transform playerTransform,\par
        Vector2 mapMin,\par
        Vector2 mapMax,\par
        float spawnRadiusFromPlayer,\par
        Action onBossDied)\par
    \{\par
        if (entry == null ||\par
            entry.EnemyStats == null ||\par
            entry.EnemyStats.EnemyPrefab == null ||\par
            playerTransform == null)\par
        \{\par
            yield break;\par
        \}\par
\par
        float elapsedTime = 0f;\par
        yield return new WaitForSeconds(2f);\par
\par
        while (waveDuration <= 0f || elapsedTime < waveDuration)\par
        \{\par
            for (int i = 0; i < entry.EnemiesPerSpawn; i++)\par
            \{\par
                Vector2 spawnPosition = Vector2.zero;\par
                bool foundPosition = false;\par
\par
                for (int attempt = 0; attempt < 10; attempt++)\par
                \{\par
                    spawnPosition = new Vector2(\par
                        UnityEngine.Random.Range(mapMin.x, mapMax.x),\par
                        UnityEngine.Random.Range(mapMin.y, mapMax.y)\par
                    );\par
\par
                    if (Vector2.Distance(playerTransform.position, spawnPosition) >= spawnRadiusFromPlayer)\par
                    \{\par
                        foundPosition = true;\par
                        break;\par
                    \}\par
                \}\par
\par
                if (EnemyRegistry.CountByType(entry.EnemyStats) >= entry.maxEnemiesInScene)\par
                    continue;\par
\par
                if (!foundPosition)\par
                    continue;\par
\par
                var enemyGO = NightPool.Spawn(\par
                    entry.EnemyStats.EnemyPrefab,\par
                    spawnPosition,\par
                    Quaternion.identity\par
                );\par
                _objectResolver?.InjectGameObject(enemyGO);\par
\par
                if (!enemyGO.TryGetComponent<Enemy>(out var enemy))\par
                    continue;\par
\par
                enemy.Init(playerTransform);\par
                if (enemy is BossEnemy)\par
                \{\par
                    Action<Enemy> onBossDiedHandler = null;\par
                    onBossDiedHandler = boss =>\par
                    \{\par
                        boss.OnDied -= onBossDiedHandler;\par
                        onBossDied?.Invoke();\par
                    \};\par
                    enemy.OnDied += onBossDiedHandler;\par
                \}\par
            \}\par
\par
            if (entry.SpawnInterval <= 0f)\par
                yield break;\par
\par
            yield return new WaitForSeconds(entry.SpawnInterval);\par
            elapsedTime += entry.SpawnInterval;\par
        \}\par
    \}\par
\}\par
