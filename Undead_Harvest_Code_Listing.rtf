    private void DespawnWeapon(int slot, WeaponSO weapon)\par
    \{\par
        if (_spawnedWeapons.TryGetValue(slot, out GameObject instance))\par
        \{\par
            NightPool.Despawn(instance);\par
            _spawnedWeapons.Remove(slot);\par
        \}\par
        Arrange();\par
    \}\par
\par
    private void Arrange()\par
    \{\par
        Transform[] children = new Transform[transform.childCount];\par
        for (int i = 0; i < transform.childCount; i++)\par
        \{\par
            children[i] = transform.GetChild(i);\par
        \}\par
\par
        ArrangeAroundCircle(children);\par
    \}\par
\par
    private void ArrangeAroundCircle(Transform[] objects)\par
    \{\par
        int totalCount = objects.Length;\par
        if (totalCount == 0)\par
        \{\par
            return;\par
        \}\par
\par
        int maxPerCircle = 8;\par
        int circleIndex = 0;\par
        int placed = 0;\par
\par
        while (placed < totalCount)\par
        \{\par
            int remaining = totalCount - placed;\par
            int countThisCircle = Mathf.Min(remaining, maxPerCircle);\par
\par
            List<float> angles = BuildVerticalSymmetricAngles(countThisCircle);\par
            float currentRadius = _radius + circleIndex * _radiusStep;\par
\par
            for (int i = 0; i < countThisCircle; i++)\par
            \{\par
                float rad = angles[i] * Mathf.Deg2Rad;\par
                Vector2 pos = new Vector2(Mathf.Cos(rad), Mathf.Sin(rad)) * currentRadius;\par
                Transform obj = objects[placed + i];\par
                obj.position = transform.position + (Vector3)pos;\par
                if (obj.TryGetComponent<Weapon>(out Weapon weapon))\par
                \{\par
                    weapon.UpdateStartPosition(obj.localPosition);\par
                \}\par
            \}\par
\par
            placed += countThisCircle;\par
            circleIndex++;\par
        \}\par
    \}\par
\par
    private List<float> BuildVerticalSymmetricAngles(int count)\par
    \{\par
        List<float> angles = new List<float>();\par
\par
        if (count == 1)\par
        \{\par
            angles.Add(0f);\par
            return angles;\par
        \}\par
\par
        if (count == 3)\par
        \{\par
            angles.Add(0f);\par
            angles.Add(90f);\par
            angles.Add(180f);\par
            return angles;\par
        \}\par
\par
        float step = 360f / count;\par
        float offset = 90f - (step * (count - 1) / 2f);\par
\par
        for (int i = 0; i < count; i++)\par
        \{\par
            angles.Add(offset + i * step);\par
        \}\par
\par
        return angles;\par
    \}\par
    private void ResetWeapons()\par
    \{\par
        foreach (var weaponGO in _spawnedWeapons.Values)\par
        \{\par
            if (weaponGO.TryGetComponent<Weapon>(out var weapon))\par
            \{\par
                weapon.ResetState();\par
            \}\par
        \}\par
    \}\par
\par
    public void StopAndHideWeapons()\par
    \{\par
        foreach (GameObject weaponGO in _spawnedWeapons.Values)\par
        \{\par
            if (weaponGO != null)\par
                NightPool.Despawn(weaponGO);\par
        \}\par
\par
        _spawnedWeapons.Clear();\par
    \}\par
\}\par
