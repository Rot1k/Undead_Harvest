public class MeeleWeapon : Weapon\par
\{\par
    public enum State \{ Idle, Attacking, Returning \}\par
\par
    public event Action OnHit;\par
\par
    private State _state;\par
    private MeeleWeaponSO _meleeWeaponSO;\par
    private void Start()\par
    \{\par
\par
        _meleeWeaponSO = _weaponBaseStats as MeeleWeaponSO;\par
        if (_meleeWeaponSO == null)\par
            Debug.LogError($"[\{name\}] Invalid MeleeWeaponSO");\par
\par
        _state = State.Idle;\par
        OriginalLocalPosition = transform.localPosition;\par
    \}\par
\par
    private void Update()\par
    \{\par
        // Використовуємо базовий Targeting та Aim\par
        base.UpdateTarget();              // тепер доступно\par
        base.LookAtTargetOrInput();       // візуальний поворот\par
\par
        switch (_state)\par
        \{\par
            case State.Idle:\par
                if (HasTarget && Time.time >= _nextFireTime)\par
                \{\par
                    _state = State.Attacking;\par
                \}\par
                break;\par
\par
            case State.Attacking:\par
                Attack();\par
                break;\par
\par
            case State.Returning:\par
                Return();\par
                break;\par
        \}\par
    \}\par
\par
    private void Attack()\par
    \{\par
        if (!HasTarget)\par
        \{\par
            _state = State.Returning;\par
            return;\par
        \}\par
\par
        transform.position = Vector2.MoveTowards(\par
            transform.position,\par
            _lockedEnemy.position,\par
            _meleeWeaponSO.WeaponSpeed * Time.deltaTime\par
        );\par
\par
        if (Vector2.Distance(transform.position, _lockedEnemy.position) < 0.1f)\par
        \{\par
            if (_lockedEnemy.TryGetComponent<Enemy>(out Enemy enemy))\par
            \{\par
                Damage(enemy);\par
            \}\par
\par
            _state = State.Returning;\par
        \}\par
    \}\par
\par
    private void OnTriggerEnter2D(Collider2D other)\par
    \{\par
        if (_state != State.Attacking) return;\par
\par
        if (other.TryGetComponent<Enemy>(out Enemy enemy))\par
        \{\par
            Damage(enemy);\par
            _soundManager?.PlaySound(SoundType.HIT);\par
            OnHit?.Invoke();\par
            _state = State.Returning;\par
        \}\par
    \}\par
\par
    private void Return()\par
    \{\par
        transform.localPosition = Vector2.MoveTowards(\par
            transform.localPosition,\par
            OriginalLocalPosition,\par
            _meleeWeaponSO.WeaponSpeed * Time.deltaTime\par
        );\par
\par
        if (Vector2.Distance(transform.localPosition, OriginalLocalPosition) < 0.1f)\par
        \{\par
            _state = State.Idle;\par
            _lockedEnemy = null;\par
\par
            base.ApplyCooldown(Time.time); // використання базового DoCooldown\par
        \}\par
    \}\par
\par
    private void Damage(Enemy enemy)\par
    \{\par
        int damage = Mathf.RoundToInt(\par
            CombatSystem.CalculateDamage(_playerStats, _weaponBaseStats)\par
        );\par
        Debug.Log($"Hit \{enemy.name\} for \{damage\} damage.");\par
        enemy.HealthSystem.Damage(damage);\par
        HandleOnHit(enemy);\par
    \}\par
\}\par
