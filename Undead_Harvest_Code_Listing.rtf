﻿using R3;\par
using System;\par
using UnityEngine;\par
public class HealthSystem\par
\{\par
    public event EventHandler OnDead;\par
\par
    private readonly ReactiveProperty<int> _healthMax;\par
    private readonly ReactiveProperty<int> _health;\par
\par
    public ReadOnlyReactiveProperty<int> HealthMax => _healthMax;\par
    public ReadOnlyReactiveProperty<int> Health => _health;\par
\par
    public HealthSystem(int healthMax)\par
    \{\par
        _healthMax = new ReactiveProperty<int>(healthMax);\par
        _health = new ReactiveProperty<int>(healthMax);\par
    \}\par
    public void SetMaxHealth(int newMax, bool keepCurrentPercent = true)\par
    \{\par
        newMax = Math.Max(1, newMax);\par
        if (newMax == _healthMax.Value) return;\par
\par
        if (keepCurrentPercent)\par
        \{\par
            float percent = (float)_health.Value / _healthMax.Value;\par
            _healthMax.Value = newMax;\par
            _health.Value = Math.Clamp(Mathf.RoundToInt(percent * _healthMax.Value), 0, _healthMax.Value);\par
        \}\par
        else\par
        \{\par
            _healthMax.Value = newMax;\par
            _health.Value = Math.Clamp(_health.Value, 0, _healthMax.Value);\par
        \}\par
\par
    \}\par
\par
\par
    public void Damage(int amount)\par
    \{\par
        if (_health.Value <= 0)\par
        \{\par
            return;\par
        \}\par
\par
        _health.Value -= amount;\par
        if (_health.Value < 0)\par
        \{\par
            _health.Value = 0;\par
        \}\par
\par
\par
        if (_health.Value <= 0)\par
        \{\par
            Die();\par
        \}\par
    \}\par
\par
    public void Die()\par
    \{\par
        OnDead?.Invoke(this, EventArgs.Empty);\par
    \}\par
    public void Heal(int amount)\par
    \{\par
        _health.Value += amount;\par
        if (_health.Value > _healthMax.Value)\par
        \{\par
            _health.Value = _healthMax.Value;\par
        \}\par
    \}\par
    public void Reset(int maxHealth)\par
    \{\par
        _healthMax.Value = maxHealth;\par
        _health.Value = maxHealth;\par
    \}\par
\}\par
