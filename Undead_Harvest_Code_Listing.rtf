[RequireComponent(typeof(Rigidbody2D))]\par
public abstract class Bullet : MonoBehaviour, ISpawnable\par
\{\par
    protected float _damage;\par
    private Rigidbody2D _rigidbody;\par
    private bool _isDespawning;\par
\par
    protected virtual void Awake()\par
    \{\par
        _rigidbody = GetComponent<Rigidbody2D>();\par
    \}\par
\par
    public virtual void OnSpawn()\par
    \{\par
        _isDespawning = false;\par
        _rigidbody.linearVelocity = Vector2.zero;\par
        transform.rotation = Quaternion.identity;\par
    \}\par
\par
    public virtual void Setup(Vector2 shootDir, float damage, float speed)\par
    \{\par
        _damage = damage;\par
        _rigidbody.AddForce(shootDir * speed, ForceMode2D.Impulse);\par
\par
        float angle = Mathf.Atan2(shootDir.y, shootDir.x) * Mathf.Rad2Deg;\par
        transform.Rotate(0f, 0f, angle);\par
    \}\par
\par
    private void OnTriggerEnter2D(Collider2D collision)\par
    \{\par
        if (IsObstacle(collision))\par
        \{\par
            Despawn();\par
            return;\par
        \}\par
\par
        if (TryGetTarget(collision, out var target))\par
        \{\par
            target.HealthSystem.Damage(Mathf.RoundToInt(_damage));\par
\par
            OnHit(target);\par
\par
            Despawn();\par
        \}\par
    \}\par
\par
    protected virtual bool IsObstacle(Collider2D collision)\par
    \{\par
        return collision.gameObject.layer == LayerMask.NameToLayer("Obstacle");\par
    \}\par
\par
    protected abstract bool TryGetTarget(Collider2D collision, out IDamageable target);\par
\par
    protected virtual void OnHit(IDamageable target) \{ \}\par
\par
    protected void Despawn()\par
    \{\par
        if (_isDespawning)\par
            return;\par
\par
        _isDespawning = true;\par
        NightPool.Despawn(gameObject);\par
    \}\par
\}\par
