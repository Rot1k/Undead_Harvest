    public event Action<StatType, float> OnStatChanged;\par
\par
    private readonly PlayerStatsSO _baseStats;\par
    private readonly StatusEffectsListSO _effects;\par
\par
    private readonly Dictionary<StatType, Stat> _stats = new();\par
    private readonly Dictionary<StatType, Action<float>> _statHandlers = new();\par
