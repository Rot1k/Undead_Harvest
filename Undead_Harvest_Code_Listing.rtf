using System.Linq;\par
using UnityEngine;\par
\par
public class ShopService : IShopService\par
\{\par
\par
    private const float WEAPON_CHANCE = 0.35f;\par
\par
    private readonly WavesManager _wavesManager;\par
    private readonly EquipmentManager _equipmentManager;\par
    private readonly WalletManager _walletManager;\par
    private readonly SoundManager _soundManager;\par
\par
    private InventoryItemsPoolSO _itemsPool;\par
    private RarityConfigSO _rarityConfig;\par
\par
    public ShopService(\par
        WavesManager wavesManager,\par
        EquipmentManager equipmentManager,\par
        WalletManager walletManager,\par
        SoundManager soundManager)\par
    \{\par
        _wavesManager = wavesManager;\par
        _equipmentManager = equipmentManager;\par
        _walletManager = walletManager;\par
        _soundManager = soundManager;\par
    \}\par
\par
    public void Initialize(InventoryItemsPoolSO itemsPool, RarityConfigSO rarityConfig)\par
    \{\par
        _itemsPool = itemsPool;\par
        _rarityConfig = rarityConfig;\par
    \}\par
\par
    public InventoryItemSO RollRandomItem()\par
    \{\par
        if (_itemsPool == null || _itemsPool.Items == null || _itemsPool.Items.Length == 0)\par
        \{\par
            Debug.LogWarning("Items pool is empty or not assigned.");\par
            return null;\par
        \}\par
\par
        bool wantWeapon = Random.value < WEAPON_CHANCE;\par
        Rarity rolledRarity = _rarityConfig != null ? _rarityConfig.GetRandomEntry().Rarity : Rarity.Common;\par
\par
        var candidates = _itemsPool.Items\par
            .Where(i => wantWeapon ? i is WeaponSO : i is PassiveItemSO)\par
            .ToList();\par
\par
        if (candidates.Count == 0)\par
            candidates = _itemsPool.Items.ToList();\par
\par
        var rarityFiltered = candidates.Where(i => i.Rarity == rolledRarity).ToList();\par
        if (rarityFiltered.Count > 0)\par
            candidates = rarityFiltered;\par
\par
        return candidates[Random.Range(0, candidates.Count)];\par
    \}\par
\par
    public int CalculateItemPrice(InventoryItemSO item)\par
    \{\par
        if (item == null)\par
            return 0;\par
\par
        float basePrice = item.Price;\par
        int currentWave = _wavesManager != null ? _wavesManager.CurrentWave : 0;\par
        return Mathf.RoundToInt(basePrice + currentWave + (basePrice * 0.1f * currentWave));\par
    \}\par
\par
    public bool TryBuyItem(InventoryItemSO item, out string error)\par
    \{\par
        error = null;\par
        if (item == null)\par
        \{\par
            error = "No item selected";\par
            return false;\par
        \}\par
\par
        if (_walletManager == null || _equipmentManager == null)\par
        \{\par
            error = "Shop dependencies are not available";\par
            return false;\par
        \}\par
\par
        int price = CalculateItemPrice(item);\par
        if (_walletManager.Balance < price)\par
        \{\par
            error = "Not enough money";\par
            return false;\par
        \}\par
\par
        bool purchased = item switch\par
        \{\par
            PassiveItemSO passive => TryBuyPassiveItem(passive, out error),\par
            WeaponSO weapon => TryBuyWeapon(weapon, out error),\par
            _ => false\par
        \};\par
\par
        if (!purchased)\par
        \{\par
            if (error == null)\par
                error = "Unsupported item type";\par
            return false;\par
        \}\par
\par
        _walletManager.TrySpendMoney(price);\par
        _soundManager?.PlaySound(SoundType.BUY);\par
        return true;\par
    \}\par
\par
    private bool TryBuyPassiveItem(PassiveItemSO item, out string error)\par
    \{\par
        error = null;\par
        _equipmentManager.AddItem(item);\par
        return true;\par
    \}\par
\par
    private bool TryBuyWeapon(WeaponSO weapon, out string error)\par
    \{\par
        error = null;\par
        int emptySlot = _equipmentManager.GetFirstEmptyWeaponSlot();\par
        if (emptySlot != -1)\par
        \{\par
            _equipmentManager.EquipWeapon(weapon, emptySlot);\par
            return true;\par
        \}\par
\par
        int sameWeaponIndex = _equipmentManager.FindWeaponIndex(weapon);\par
        if (sameWeaponIndex == -1 || !weapon.CanUnion)\par
        \{\par
            error = "No empty slots and cannot union";\par
            return false;\par
        \}\par
\par
        _equipmentManager.ReplaceWeapon(sameWeaponIndex, weapon.UnionResult);\par
        return true;\par
    \}\par
\par
    public bool TrySellItem(InventorySlot slot, out int soldAmount, out string error)\par
    \{\par
        soldAmount = 0;\par
        error = null;\par
\par
        if (slot == null)\par
        \{\par
            error = "No slot";\par
            return false;\par
        \}\par
\par
        if (_equipmentManager == null || _walletManager == null)\par
        \{\par
            error = "Shop dependencies are not available";\par
            return false;\par
        \}\par
\par
        InventoryItemSO data = GetItemFromSlot(slot);\par
\par
        if (data == null)\par
        \{\par
            error = "No item to sell";\par
            return false;\par
        \}\par
\par
        soldAmount = data.Price / 2;\par
\par
        bool sold = slot switch\par
        \{\par
            WeaponInventorySlot weaponSlot => TrySellWeapon(weaponSlot, out error),\par
            ItemInventorySlot itemSlot => TrySellPassiveItem(itemSlot, out error),\par
            _ => false\par
        \};\par
\par
        if (!sold)\par
        \{\par
            if (error == null)\par
                error = "Unsupported inventory slot type";\par
            return false;\par
        \}\par
\par
        _walletManager.AddMoney(soldAmount);\par
        return true;\par
    \}\par
\par
    private InventoryItemSO GetItemFromSlot(InventorySlot slot)\par
    \{\par
        return slot switch\par
        \{\par
            WeaponInventorySlot weaponSlot => _equipmentManager.GetWeapon(weaponSlot.SlotIndex),\par
            ItemInventorySlot itemSlot => itemSlot.Item?.PassiveItemSO,\par
            _ => null\par
        \};\par
    \}\par
\par
    private bool TrySellWeapon(WeaponInventorySlot slot, out string error)\par
    \{\par
        error = null;\par
        _equipmentManager.UnequipWeapon(slot.SlotIndex);\par
        return true;\par
    \}\par
\par
    private bool TrySellPassiveItem(ItemInventorySlot slot, out string error)\par
    \{\par
        error = null;\par
        if (slot.Item == null)\par
        \{\par
            error = "No item to sell";\par
            return false;\par
        \}\par
\par
        _equipmentManager.RemovePassiveItem(slot.Item);\par
        return true;\par
    \}\par
\par
    public bool TryUnion(InventorySlot slot, out string error)\par
    \{\par
        error = null;\par
\par
        if (_equipmentManager == null)\par
        \{\par
            error = "Equipment manager is not available";\par
            return false;\par
        \}\par
\par
        if (slot is not WeaponInventorySlot weaponSlot)\par
        \{\par
            error = "Invalid slot for union";\par
            return false;\par
        \}\par
\par
        WeaponSO weapon = _equipmentManager.GetWeapon(weaponSlot.SlotIndex);\par
        if (weapon == null)\par
        \{\par
            error = "No weapon in the selected slot";\par
            return false;\par
        \}\par
\par
        if (!weapon.CanUnion)\par
        \{\par
            error = "This weapon cannot union";\par
            return false;\par
        \}\par
\par
        int secondWeaponIndex = _equipmentManager.FindSecondWeaponIndex(weapon, weaponSlot.SlotIndex);\par
        if (secondWeaponIndex == -1)\par
        \{\par
            error = "No matching weapon to union";\par
            return false;\par
        \}\par
\par
        _equipmentManager.UnequipWeapon(secondWeaponIndex);\par
        _equipmentManager.ReplaceWeapon(weaponSlot.SlotIndex, weapon.UnionResult);\par
        return true;\par
    \}\par
\}\par
