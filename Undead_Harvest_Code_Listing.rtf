using NTC.Pool;\par
using System;\par
using System.Collections;\par
using UnityEngine;\par
\par
public enum AttackType\par
\{\par
    AttackAround,\par
    BurstAttack\par
\}\par
\par
public class BossEnemy : Enemy\par
\{\par
    public static event Action<BossEnemy> OnBossSpawned;\par
\par
    [SerializeField] private Bullet _bulletPrefab;\par
    private BossEnemyStatsSO _bossEnemyStats;\par
\par
    private bool _isAttacking = false;\par
\par
    protected override void Awake()\par
    \{\par
        base.Awake();\par
        _bossEnemyStats = _enemyStats as BossEnemyStatsSO;\par
        if (_bossEnemyStats == null)\par
            Debug.LogError("_enemyStats is not a RangerEnemyStatsSO!");\par
    \}\par
\par
    private void Start()\par
    \{\par
        StartCoroutine(AttackLoop());\par
    \}\par
    public override void OnSpawn()\par
    \{\par
        base.OnSpawn();\par
        OnBossSpawned?.Invoke(this);\par
    \}\par
    protected override void OnDead(object sender, EventArgs e)\par
    \{\par
        base.OnDead(sender, e);\par
        StopAllCoroutines();\par
    \}\par
\par
    private IEnumerator AttackLoop()\par
    \{\par
        while (!IsDead)\par
        \{\par
            if (Player == null)\par
            \{\par
                yield return new WaitForSeconds(1f);\par
                continue;\par
            \}\par
\par
            _isAttacking = true;\par
            yield return new WaitForSeconds(1f);\par
\par
            switch (GetRandomAttack())\par
            \{\par
                case AttackType.AttackAround:\par
                    yield return StartCoroutine(AttackAroundCoroutine());\par
                    break;\par
                case AttackType.BurstAttack:\par
                    yield return StartCoroutine(BurstAttackCoroutine());\par
                    break;\par
            \}\par
\par
            _isAttacking = false;\par
            yield return new WaitForSeconds(_bossEnemyStats.FireRate);\par
        \}\par
    \}\par
\par
    protected override void FixedUpdate()\par
    \{\par
        if (IsDead) return;\par
        if (Player == null) return;\par
\par
\par
        if (!_isAttacking)\par
        \{\par
            MoveToPlayer();\par
        \}\par
        else\par
        \{\par
            Rigidbody.linearVelocity = Vector2.zero;\par
        \}\par
    \}\par
\par
    private IEnumerator AttackAroundCoroutine()\par
    \{\par
        int bulletCount = 12;\par
        float angleStep = 360f / bulletCount;\par
        float angleOffset = 15f;\par
\par
        for (int attacks = 0; attacks < 3; attacks++)\par
        \{\par
            for (int i = 0; i < bulletCount; i++)\par
            \{\par
                float angle = (i * angleStep) + (angleOffset * attacks);\par
                Quaternion rotation = Quaternion.Euler(0, 0, angle);\par
                Bullet bullet = NightPool.Spawn(_bulletPrefab, transform.position, rotation);\par
                bullet.Setup(rotation * Vector2.up, _bossEnemyStats.BaseDamage, _bossEnemyStats.BulletSpeed);\par
            \}\par
            yield return new WaitForSeconds(0.6f);\par
        \}\par
    \}\par
\par
    private IEnumerator BurstAttackCoroutine()\par
    \{\par
        float halfCone = 15f;\par
        for (int shots = 0; shots < 3; shots++)\par
        \{\par
            Vector2 origin = transform.position;\par
            Vector2 targetPos = Player.position;\par
            Vector2 baseDir = (targetPos - origin).normalized;\par
\par
            for (int burst = 0; burst < 3; burst++)\par
            \{\par
                for (int i = -1; i <= 1; i++)\par
                \{\par
                    Quaternion rotation = Quaternion.Euler(0f, 0f, i * halfCone);\par
                    Vector2 dir = rotation * baseDir;\par
\par
                    Bullet bullet = NightPool.Spawn(_bulletPrefab, transform.position, rotation);\par
                    bullet.Setup(dir, _bossEnemyStats.BaseDamage, _bossEnemyStats.BulletSpeed);\par
                    yield return new WaitForSeconds(0.1f);\par
                \}\par
            \}\par
            yield return new WaitForSeconds(0.6f);\par
        \}\par
    \}\par
\par
    private AttackType GetRandomAttack()\par
    \{\par
        return UnityEngine.Random.value < 0.5f ? AttackType.AttackAround : AttackType.BurstAttack;\par
    \}\par
\}\par
