    public void RemoveModifiersFromSource(Guid sourceId)\par
    \{\par
        _modifiers.RemoveAll(m => m.SourceId == sourceId);\par
        Recalculate();\par
    \}\par
\par
    private void Recalculate()\par
    \{\par
        float value = BaseValue;\par
        float addPercent = 0f;\par
        float multiplier = 1f;\par
\par
        foreach (var m in _modifiers)\par
        \{\par
            switch (m.Type)\par
            \{\par
                case ModifierType.Flat:\par
                    value += m.Value;\par
                    break;\par
                case ModifierType.AddPercent:\par
                    addPercent += m.Value;\par
                    break;\par
                case ModifierType.Multiplier:\par
                    multiplier *= m.Value;\par
                    break;\par
            \}\par
        \}\par
\par
        value *= 1f + addPercent;\par
        value *= multiplier;\par
\par
        float newValue = value;\par
\par
        if (Math.Abs(newValue - _cachedValue) > 0.0001f)\par
        \{\par
            _cachedValue = newValue;\par
            OnValueChanged?.Invoke(_cachedValue);\par
        \}\par
    \}\par
