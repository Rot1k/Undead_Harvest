\par
public class WavesManager : MonoBehaviour\par
\{\par
\par
    public event Action OnWaveCompleted;\par
    public event Action OnWaveStarted;\par
    public event Action OnAllWavesCompleted;\par
\par
    public bool IsAllWavesCompleted \{ get; private set; \} = false;\par
\par
    [SerializeField] private Transform _playerTransform;\par
    [SerializeField] private WaveConfigSO[] _waves;\par
\par
    private Vector2 _mapMin = new Vector2(-10f, -6f);\par
    private Vector2 _mapMax = new Vector2(10f, 6f);\par
    private float _spawnRadiusFromPlayer = 1.5f;\par
    public int CurrentWave \{ get; private set; \} = 0;\par
    private List<Coroutine> _spawnCoroutines = new();\par
    private Coroutine _waveCoroutine;\par
    private EnemySpawner _enemySpawner;\par
\par
    [Inject]\par
    public void Construct(EnemySpawner enemySpawner)\par
    \{\par
        _enemySpawner = enemySpawner;\par
    \}\par
\par
    public void StartGame()\par
    \{\par
        StartCoroutine(StartFirstWave());\par
    \}\par
\par
    private IEnumerator StartFirstWave()\par
    \{\par
        if(_waveCoroutine != null)\par
        \{\par
            Debug.LogWarning("A wave is already running on Start!");\par
            yield break;\par
        \}\par
\par
        yield return null;\par
        StartNextWave();\par
    \}\par
\par
    public void StartNextWave()\par
    \{\par
        if (_waves == null || _waves.Length == 0)\par
        \{\par
            Debug.LogWarning("No waves configured!");\par
            return;\par
        \}\par
        if (_waveCoroutine != null)\par
        \{\par
            Debug.LogWarning("A wave is already running!");\par
            return;\par
        \}\par
        if (_enemySpawner == null)\par
        \{\par
            Debug.LogError("Enemy spawner is not configured.", this);\par
            return;\par
        \}\par
        if (CurrentWave >= _waves.Length)\par
        \{\par
            Debug.LogWarning("All waves have already been completed!");\par
            return;\par
        \}\par
        _waveCoroutine = StartCoroutine(RunWave());\par
    \}\par
    private IEnumerator RunWave()\par
    \{\par
        OnWaveStarted?.Invoke();\par
        var wave = _waves[CurrentWave];\par
        if (wave == null)\par
        \{\par
            Debug.LogError($"Wave \{CurrentWave\} is not configured.", this);\par
            EndCurrentWave();\par
            yield break;\par
        \}\par
\par
        Debug.Log($"Starting wave \{CurrentWave + 1\}/\{_waves.Length\}");\par
        if (wave.Enemies == null)\par
        \{\par
            Debug.LogError($"Wave \{CurrentWave\} has no enemy entries.", this);\par
            EndCurrentWave();\par
            yield break;\par
        \}\par
\par
        foreach (var entry in wave.Enemies)\par
        \{\par
            var routine = StartCoroutine(_enemySpawner.SpawnRoutine(\par
                entry,\par
                wave.WaveDuration,\par
                _playerTransform,\par
                _mapMin,\par
                _mapMax,\par
                _spawnRadiusFromPlayer,\par
                EndCurrentWave));\par
            _spawnCoroutines.Add(routine);\par
            yield return new WaitForSeconds(0.5f);\par
        \}\par
\par
        if (wave.WaveDuration <= 0)\par
        \{\par
            EndCurrentWave();\par
            yield break;\par
        \}\par
\par
        float remainingDuration = Mathf.Max(0f, wave.WaveDuration - (0.5f * (wave.Enemies.Count - 1)));\par
        yield return new WaitForSeconds(remainingDuration);\par
        EndCurrentWave();\par
    \}\par
    private void DespawnAllEntities()\par
    \{\par
        NightPool.ForEachPool(pool =>\par
        \{\par
            if (pool == null || pool.AttachedPrefab == null)\par
                return;\par
\par
            // Skip the pool that uses Weapon prefab\par
            if (pool.AttachedPrefab.TryGetComponent<Weapon>(out _))\par
                return;\par
            if (pool.AttachedPrefab.TryGetComponent<ItemInventorySlot>(out _))\par
                return;\par
\par
            try\par
            \{\par
                pool.DespawnAllClones();\par
            \}\par
            catch (Exception ex)\par
            \{\par
                Debug.LogWarning($"Error despawning pool '\{pool.AttachedPrefab.name\}': \{ex.Message\}");\par
            \}\par
        \});\par
    \}\par
    public void StopCurrentWave()\par
    \{\par
        if (_waveCoroutine == null)\par
        \{\par
            return;\par
        \}\par
\par
        foreach (var spawnCoroutine in _spawnCoroutines)\par
        \{\par
            StopCoroutine(spawnCoroutine);\par
        \}\par
\par
        _spawnCoroutines.Clear();\par
        _waveCoroutine = null;\par
    \}\par
\par
    private void EndCurrentWave()\par
    \{\par
        if (_waveCoroutine == null)\par
        \{\par
            return;\par
        \}\par
\par
        StopCurrentWave();\par
        DespawnAllEntities();\par
        CurrentWave++;\par
\par
        if (CurrentWave >= _waves.Length)\par
        \{\par
            Debug.Log("All waves completed!");\par
            IsAllWavesCompleted = true;\par
            OnAllWavesCompleted?.Invoke();\par
        \}\par
        else\par
        \{\par
            OnWaveCompleted?.Invoke();\par
        \}\par
    \}\par
    public WaveConfigSO GetCurrentWave()\par
    \{\par
        if (CurrentWave < 0 || CurrentWave >= _waves.Length)\par
            return null;\par
        return _waves[CurrentWave];\par
    \}\par
\}\par
