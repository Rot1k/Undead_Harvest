using System.Collections;\par
using System.Collections.Generic;\par
using UnityEngine;\par
\par
[RequireComponent(typeof(AudioSource))]\par
public class BackgroundMusicManager : MonoBehaviour\par
\{\par
    private const string PLAYER_PREFS_BACKGROUND_MUSIC_VOLUME = "BackgroundMusicVolume";\par
\par
    [SerializeField] private AudioClip[] _backgroundMusicClips;\par
    [SerializeField] private float _delayBetweenTracks = 6f;\par
    [SerializeField] private float _delayBeforeFirstTrack = 2f;\par
\par
    private AudioSource _audioSource;\par
    private List<int> _clipIndices = new List<int>();\par
    private int _currentIndex = 0;\par
    private Coroutine _trackCoroutine;\par
    public float Volume \{ get; private set; \} = 1f;\par
\par
    private void Awake()\par
    \{\par
        _audioSource = GetComponent<AudioSource>();\par
\par
        Loader.OnAfterSceneLoad += OnAfterSceneLoad;\par
        OnAfterSceneLoad();\par
\par
        _audioSource.volume = Volume;\par
    \}\par
\par
    private void Start()\par
    \{\par
        if (_backgroundMusicClips == null || _backgroundMusicClips.Length == 0)\par
        \{\par
            Debug.LogWarning("No background music clips assigned.");\par
            return;\par
        \}\par
\par
        PrepareShuffledPlaylist();\par
        StartCoroutine(PlayMusicWithDelay());\par
    \}\par
\par
\par
    private void OnDestroy()\par
    \{\par
        if (_trackCoroutine != null)\par
        \{\par
            StopCoroutine(_trackCoroutine);\par
        \}\par
\par
        Loader.OnAfterSceneLoad -= OnAfterSceneLoad;\par
    \}\par
\par
    private void PrepareShuffledPlaylist()\par
    \{\par
        _clipIndices.Clear();\par
        for (int i = 0; i < _backgroundMusicClips.Length; i++)\par
        \{\par
            _clipIndices.Add(i);\par
        \}\par
\par
        Shuffle(_clipIndices);\par
        _currentIndex = 0;\par
    \}\par
\par
    private void PlayNextTrack()\par
    \{\par
        if (_clipIndices.Count == 0 || _backgroundMusicClips.Length == 0) return;\par
\par
        if (_currentIndex >= _clipIndices.Count)\par
        \{\par
            PrepareShuffledPlaylist();\par
        \}\par
\par
        int clipIndex = _clipIndices[_currentIndex];\par
        AudioClip clipToPlay = _backgroundMusicClips[clipIndex];\par
        _audioSource.clip = clipToPlay;\par
        _audioSource.Play();\par
        _currentIndex++;\par
\par
        _trackCoroutine = StartCoroutine(WaitUntilTrackEnds(clipToPlay.length));\par
    \}\par
\par
    private IEnumerator PlayMusicWithDelay()\par
    \{\par
        yield return new WaitForSeconds(_delayBeforeFirstTrack);\par
        PlayNextTrack();\par
    \}\par
\par
    private IEnumerator WaitUntilTrackEnds(float clipLength)\par
    \{\par
        yield return new WaitForSeconds(clipLength + _delayBetweenTracks);\par
        PlayNextTrack();\par
    \}\par
\par
    private void Shuffle(List<int> list)\par
    \{\par
        for (int i = list.Count - 1; i > 0; i--)\par
        \{\par
            int j = Random.Range(0, i + 1);\par
            (list[i], list[j]) = (list[j], list[i]);\par
        \}\par
    \}\par
\par
    public void SetVolume(float volume)\par
    \{\par
        Volume = Mathf.Clamp01(volume);\par
\par
        if (_audioSource != null)\par
        \{\par
            _audioSource.volume = Volume;\par
        \}\par
        else\par
        \{\par
            Debug.LogWarning("AudioSource not initialized.");\par
        \}\par
\par
        PlayerPrefs.SetFloat(PLAYER_PREFS_BACKGROUND_MUSIC_VOLUME, Volume);\par
        PlayerPrefs.Save();\par
    \}\par
    private void OnAfterSceneLoad()\par
    \{\par
        Volume = PlayerPrefs.GetFloat(PLAYER_PREFS_BACKGROUND_MUSIC_VOLUME, 1f);\par
        if (_audioSource != null)\par
        \{\par
            _audioSource.volume = Volume;\par
        \}\par
    \}\par
\}\par
