using UnityEngine;\par
\par
public static class CombatSystem\par
\{\par
    public static float CalculateDamage(PlayerStats playerStats, WeaponSO weaponStats)\par
    \{\par
        float baseDamage = weaponStats.BaseDamage;\par
        float scalingDamage;\par
        if (weaponStats.ScalingStats != null && weaponStats.ScalingStats.Count > 0)\par
        \{\par
            scalingDamage = 0f;\par
            foreach (var scalingEntry in weaponStats.ScalingStats)\par
            \{\par
                float statValue = playerStats.Get(scalingEntry.ScalingStatType);\par
                scalingDamage += statValue * scalingEntry.ScalingFactor;\par
            \}\par
        \}\par
        else\par
        \{\par
            scalingDamage = 0f;\par
        \}\par
        float attackDamage = playerStats.Get(StatType.AttackDamage);\par
        float totalDamage = baseDamage + scalingDamage + attackDamage;\par
\par
        float critChance = playerStats.Get(StatType.CriticalChance);\par
        float critMultiplier = playerStats.Get(StatType.CriticalDamageMultiplier);\par
        if(Random.Range(0f, 100f) < critChance)\par
        \{\par
            totalDamage *= critMultiplier;\par
            Debug.Log($"Critical Hit! Damage: \{totalDamage\}");\par
        \}\par
        return totalDamage;\par
    \}\par
\}\par
