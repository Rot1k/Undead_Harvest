using System;\par
using UnityEngine;\par
using R3;\par
public class LevelSystem\par
\{\par
    public event EventHandler OnLevelChanged;\par
    public event EventHandler OnExpChanged;\par
    public event EventHandler OnSkillPointUsed;\par
\par
    private ReactiveProperty<int> _level;\par
    private ReactiveProperty<float> _currentExp;\par
    private ReactiveProperty<float> _expToNextLevel;\par
\par
    public ReadOnlyReactiveProperty<int> Level => _level;\par
    public ReadOnlyReactiveProperty<float> CurrentExp => _currentExp;\par
    public ReadOnlyReactiveProperty<float> ExpToNextLevel => _expToNextLevel;\par
\par
    public int SkillPoints \{ get; private set; \}\par
\par
    private readonly float _baseExp = 100f;\par
    private readonly float _growthFactor = 1.15f;\par
\par
    public LevelSystem()\par
    \{\par
        _level = new ReactiveProperty<int>(0);\par
        _currentExp = new ReactiveProperty<float>(0f);\par
        _expToNextLevel = new ReactiveProperty<float>(_baseExp);\par
    \}\par
\par
    public void AddExp(float exp)\par
    \{\par
        _currentExp.Value += exp;\par
\par
        while (_currentExp.Value >= _expToNextLevel.Value)\par
        \{\par
            _currentExp.Value -= _expToNextLevel.Value;\par
            _level.Value++;\par
            SkillPoints++;\par
            RecalculateExpToNextLevel();\par
            OnLevelChanged?.Invoke(this, EventArgs.Empty);\par
        \}\par
\par
        OnExpChanged?.Invoke(this, EventArgs.Empty);\par
        Debug.Log($"Level: \{_level.Value\}, Exp: \{_currentExp.Value\}/\{_expToNextLevel.Value\}");\par
    \}\par
\par
    public void UseSkillPoint(int amount)\par
    \{\par
        if (SkillPoints >= amount)\par
        \{\par
            SkillPoints -= amount;\par
            OnSkillPointUsed?.Invoke(this, EventArgs.Empty);\par
        \}\par
    \}\par
    private void RecalculateExpToNextLevel()\par
    \{\par
        _expToNextLevel.Value = _baseExp * Mathf.Pow(_growthFactor, _level.Value);\par
    \}\par
\}\par
